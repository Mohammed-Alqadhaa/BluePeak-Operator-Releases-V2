        <LineGeometry StartPoint="2,11.6" EndPoint="14,11.6"/>
        <EllipseGeometry Center="10.6,4.4" RadiusX="1.7" RadiusY="1.7"/>
        <EllipseGeometry Center="5.4,8" RadiusX="1.7" RadiusY="1.7"/>
        <EllipseGeometry Center="9.4,11.6" RadiusX="1.7" RadiusY="1.7"/>
