    <!-- Transport and command glyphs -->
    <GeometryGroup x:Key="I.Play">
        <PathGeometry Figures="M4.5,2.8 L12.5,8 L4.5,13.2 Z"/>
    </GeometryGroup>
    <GeometryGroup x:Key="I.Pause">
        <RectangleGeometry Rect="4.4,3,2.6,10"/>
        <RectangleGeometry Rect="9,3,2.6,10"/>
    </GeometryGroup>
    <GeometryGroup x:Key="I.Replay">
        <PathGeometry Figures="M13,8 A5,5 0 1,1 8,3"/>
        <PathGeometry Figures="M8,0.6 L8,5.4 L11.4,3"/>
    </GeometryGroup>
    <GeometryGroup x:Key="I.StepBack">
        <RectangleGeometry Rect="3.2,3,1.8,10"/>
        <PathGeometry Figures="M12.8,3 L12.8,13 L6.2,8 Z"/>
