<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A stroke-only icon set on a 16x16 grid. Drawn from primitives rather than a font so
         nothing depends on a glyph being installed and every line lands on the same rhythm. -->

    <GeometryGroup x:Key="I.Overview">
        <LineGeometry StartPoint="1.5,13.5" EndPoint="14.5,13.5"/>
        <PathGeometry Figures="M2,11 L5.5,6 L8.5,8.5 L11.5,3"/>
        <EllipseGeometry Center="11.5,3" RadiusX="1.3" RadiusY="1.3"/>
    </GeometryGroup>

    <GeometryGroup x:Key="I.Noc">
        <EllipseGeometry Center="8,3.6" RadiusX="1.9" RadiusY="1.9"/>
        <EllipseGeometry Center="3.4,12.4" RadiusX="1.7" RadiusY="1.7"/>
        <EllipseGeometry Center="12.6,12.4" RadiusX="1.7" RadiusY="1.7"/>
        <LineGeometry StartPoint="7,5.4" EndPoint="4.3,10.6"/>
        <LineGeometry StartPoint="9,5.4" EndPoint="11.7,10.6"/>
        <LineGeometry StartPoint="5.1,12.4" EndPoint="10.9,12.4"/>
    </GeometryGroup>

    <GeometryGroup x:Key="I.Soc">
        <PathGeometry Figures="M8,1.6 L13.6,4 L13.6,8 C13.6,11.4 11.2,13.6 8,14.6 C4.8,13.6 2.4,11.4 2.4,8 L2.4,4 Z"/>
        <PathGeometry Figures="M5.6,8 L7.3,9.8 L10.6,5.9"/>
    </GeometryGroup>

    <GeometryGroup x:Key="I.Desk">
        <PathGeometry Figures="M3,9 L3,7.6 C3,4.9 5.2,2.8 8,2.8 C10.8,2.8 13,4.9 13,7.6 L13,9"/>
        <RectangleGeometry Rect="1.7,8.6,2.8,4.2" RadiusX="1" RadiusY="1"/>
        <RectangleGeometry Rect="11.5,8.6,2.8,4.2" RadiusX="1" RadiusY="1"/>
        <PathGeometry Figures="M12.9,12.8 L12.9,13.6 L8.8,13.6"/>
    </GeometryGroup>

    <GeometryGroup x:Key="I.Ticket">
        <PathGeometry Figures="M2.2,4.4 L8.4,4.4 L13.6,9.6 L9.2,14 L4,8.8 L4,4.4 Z"/>
        <EllipseGeometry Center="6.2,6.6" RadiusX="1" RadiusY="1"/>
