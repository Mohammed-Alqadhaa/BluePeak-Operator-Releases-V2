    </GeometryGroup>

    <GeometryGroup x:Key="I.Infrastructure">
        <PathGeometry Figures="M8,1.8 L14.4,4.9 L8,8 L1.6,4.9 Z"/>
        <PathGeometry Figures="M1.6,8 L8,11.1 L14.4,8"/>
        <PathGeometry Figures="M1.6,11 L8,14.1 L14.4,11"/>
