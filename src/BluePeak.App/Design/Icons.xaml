        <PathGeometry Figures="M8.4,11.4 L6.6,13.2 A2.6,2.6 0 0,1 2.8,9.4 L4.6,7.6"/>
    </GeometryGroup>
    <GeometryGroup x:Key="I.Pin">
        <PathGeometry Figures="M6,1.8 L10,1.8 L9.2,6 L12,8.4 L4,8.4 L6.8,6 Z"/>
        <LineGeometry StartPoint="8,8.4" EndPoint="8,14.2"/>
    </GeometryGroup>
    <GeometryGroup x:Key="I.Close">
        <LineGeometry StartPoint="4,4" EndPoint="12,12"/>
        <LineGeometry StartPoint="12,4" EndPoint="4,12"/>
    </GeometryGroup>
    <GeometryGroup x:Key="I.Chevron">
        <PathGeometry Figures="M6,4 L10,8 L6,12"/>
