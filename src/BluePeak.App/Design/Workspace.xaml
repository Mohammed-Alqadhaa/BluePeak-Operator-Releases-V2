<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared workspace composition. Every screen is built from the same four devices:
         a command bar, section rules, data rows and an inspector. There are no cards. -->

    <Style x:Key="Workspace.CommandBar" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource D.CommandBarHeight}"/>
        <Setter Property="Background" Value="{StaticResource B.Header}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Hairline}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="Workspace.SubBar" TargetType="Border">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="{StaticResource B.Canvas}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Hairline}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- A section is announced by a label on a rule, not by a container. -->
    <Style x:Key="Section.Bar" TargetType="Border">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="{StaticResource B.Canvas}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Hairline}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="Column.Header" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource D.HeaderHeight}"/>
        <Setter Property="Background" Value="{StaticResource B.Base}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Hairline}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="Inspector" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Raised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Hairline}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>

    <!-- Chips carry classification, never decoration. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="#FF1D242E"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Chip.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource T.Micro}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Cell.Id" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource T.Data}"/>
    </Style>

    <Style x:Key="Cell.Primary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Cell.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource T.Caption}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Key/value rows inside inspectors: label column is fixed so values align down the panel. -->
    <Style x:Key="Field.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource T.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextTertiary}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <Style x:Key="Field.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="LineHeight" Value="17"/>
    </Style>

    <Style x:Key="Empty.Text" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextTertiary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="300"/>
    </Style>

    <!-- Inline link: how the operator carries a subject to another workspace. -->
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource T.Caption}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
