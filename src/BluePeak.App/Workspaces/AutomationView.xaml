<UserControl x:Class="BluePeak.App.Workspaces.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BluePeak.App.Controls"
             Background="{StaticResource B.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Workspace.CommandBar}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Automation" Style="{StaticResource Text.Title}"/>
                <Border Grid.Column="2" Background="#22E0A33E" BorderBrush="#55E0A33E" BorderThickness="1"
                        CornerRadius="2" Padding="9,3" VerticalAlignment="Center">
                    <TextBlock Text="Simulation only — no production mutation is possible in this build"
                               FontSize="{StaticResource T.Caption}" Foreground="{StaticResource B.Degraded}"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="328" MinWidth="270"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="356" MinWidth="290"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Column.Header}">
                    <Grid Margin="14,0,12,0">
                        <TextBlock Text="Runbook" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="Risk" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" x:Name="RunbookList" Style="{StaticResource List}"
                         SelectionChanged="Runbook_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="60" Margin="14,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource Cell.Id}"
                                                   FontSize="{StaticResource T.Caption}"/>
                                        <TextBlock Text="{Binding Category}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Tertiary}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Primary}"
                                               FontSize="{StaticResource T.Caption}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding LastRunResult}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Risk}" VerticalAlignment="Center"
                                           Style="{StaticResource Text.Mono}" FontSize="{StaticResource T.Micro}"
                                           Foreground="{StaticResource B.TextSecondary}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource B.Canvas}" BorderBrush="{StaticResource B.Hairline}"
                        BorderThickness="0,0,0,1" Padding="20,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock x:Name="DetailId" Style="{StaticResource Text.Mono}"
                                       Foreground="{StaticResource B.TextSecondary}"/>
                            <Border x:Name="RiskChip" Style="{StaticResource Chip}" Margin="10,0,0,0">
                                <TextBlock x:Name="RiskText" Style="{StaticResource Chip.Text}"/>
                            </Border>
                            <TextBlock x:Name="DetailOwner" Margin="10,0,0,0" Style="{StaticResource Text.Tertiary}"/>
                            <TextBlock x:Name="DetailRuns" Margin="10,0,0,0" Style="{StaticResource Text.Tertiary}"/>
                        </StackPanel>
                        <TextBlock x:Name="DetailName" Style="{StaticResource Text.Display}" FontSize="18"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailPurpose" Style="{StaticResource Text.Prose}" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Transport for the run -->
                <Border Grid.Row="1" Background="{StaticResource B.Header}" BorderBrush="{StaticResource B.Hairline}"
                        BorderThickness="0,0,0,1" Padding="20,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DryRunButton" Content="Dry run" Style="{StaticResource Button.Primary}"
                                    Height="28" Padding="16,0" Click="DryRun_Click"/>
                            <Button x:Name="GatedRunButton" Content="Gated run" Style="{StaticResource Button.Standard}"
                                    Height="28" Padding="16,0" Margin="8,0,0,0" Click="GatedRun_Click"/>
                            <Button x:Name="AuthoriseButton" Content="Authorise execution"
                                    Style="{StaticResource Button.Standard}" Height="28" Padding="16,0"
                                    Margin="8,0,0,0" Click="Authorise_Click" Visibility="Collapsed"/>
                            <Button x:Name="AbortButton" Content="Abort" Style="{StaticResource Button.Danger}"
                                    Height="28" Padding="16,0" Margin="8,0,0,0" Click="Abort_Click"
                                    IsEnabled="False"/>
                            <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource Button.Ghost}"
                                    Height="28" Padding="14,0" Margin="8,0,0,0" Click="Reset_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ctl:StatePip x:Name="OutcomePip" Width="8" Height="8" Margin="0,0,8,0"/>
                            <TextBlock x:Name="OutcomeText" Style="{StaticResource Text.Mono}"
                                       FontSize="{StaticResource T.Caption}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" x:Name="GateScroller" VerticalScrollBarVisibility="Auto" Padding="0,8,0,16">
                    <ItemsControl x:Name="GateList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <Border Style="{StaticResource Section.Bar}" Background="Transparent"
                                            BorderThickness="0,0,0,1">
                                        <Grid Margin="20,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="1" VerticalAlignment="Center"
                                                        Margin="0,0,10,0"
                                                        Background="{Binding State, Converter={StaticResource GateBrush}}"/>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Progress}" Style="{StaticResource Text.Mono}"
                                                       FontSize="{StaticResource T.Micro}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource B.TextTertiary}"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="20,9,20,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="9" Height="9" CornerRadius="4.5"
                                                            VerticalAlignment="Top" Margin="0,3,0,0"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding State, Converter={StaticResource GateBrush}}"/>
                                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource Cell.Primary}"/>
                                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                                    Background="#33E5544B" BorderBrush="#55E5544B"
                                                                    Visibility="{Binding Mutating, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="MUTATING" Style="{StaticResource Chip.Text}"
                                                                           Foreground="{StaticResource B.Critical}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                                    Background="#33E0A33E" BorderBrush="#55E0A33E"
                                                                    Visibility="{Binding RequiresApproval, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="GATE" Style="{StaticResource Chip.Text}"
                                                                           Foreground="{StaticResource B.Degraded}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Prose}"
                                                                   FontSize="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding Output}" Style="{StaticResource Text.Prose}"
                                                                   FontSize="{StaticResource T.Caption}" Margin="0,4,0,0"
                                                                   Foreground="{Binding State, Converter={StaticResource GateBrush}}"
                                                                   Visibility="{Binding Output, Converter={StaticResource NullVis}}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding State, Converter={StaticResource EnumLabel}}"
                                                               VerticalAlignment="Top" Margin="0,2,0,0"
                                                               Style="{StaticResource Text.Mono}"
                                                               FontSize="{StaticResource T.Micro}"
                                                               Foreground="{Binding State, Converter={StaticResource GateBrush}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Border Grid.Column="4" Style="{StaticResource Inspector}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,10,18">
                    <StackPanel>
                        <TextBlock Text="Safety contract" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ContractList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Left"
                                                   Fill="{Binding Tone, Converter={StaticResource HealthBrush}}"/>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                            <TextBlock Text="{Binding Question}" Style="{StaticResource Text.Tertiary}"/>
                                            <TextBlock Text="{Binding Answer}" Style="{StaticResource Field.Value}"
                                                       Margin="0,3,0,0" FontSize="{StaticResource T.Caption}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Targets" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="TargetList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="26">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ctl:StatePip Grid.Column="0" State="{Binding Health}" Width="7" Height="7"
                                                      HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Style="{StaticResource Cell.Secondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LayerLabel}"
                                                   Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Run log" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource B.Base}" BorderBrush="{StaticResource B.Hairline}"
                                BorderThickness="1" CornerRadius="2" Padding="11,9" Margin="0,0,0,16"
                                MinHeight="90">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}"
                                                   FontSize="{StaticResource T.Micro}" TextWrapping="Wrap"
                                                   Margin="0,0,0,4" Foreground="{StaticResource B.TextSecondary}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel x:Name="ActionPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
