<UserControl x:Class="BluePeak.App.Workspaces.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BluePeak.App.Controls"
             Background="{StaticResource B.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Workspace.CommandBar}">
            <Grid Margin="18,0">
                <TextBlock Text="Settings" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="What this build is permitted to do, and how it behaves"
                           Style="{StaticResource Text.Tertiary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="480" MinWidth="380"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Section.Bar}">
                        <TextBlock Text="Safety contract" Style="{StaticResource Text.Section}" Margin="20,0"/>
                    </Border>
                    <ItemsControl x:Name="ContractList" Margin="20,14,20,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Left"
                                               Fill="{Binding Tone, Converter={StaticResource HealthBrush}}"/>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                        <TextBlock Text="{Binding Question}" Style="{StaticResource Text.Subtitle}"/>
                                        <TextBlock Text="{Binding Answer}" Style="{StaticResource Text.Prose}"
                                                   Margin="0,5,0,0" MaxWidth="620" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Section.Bar}">
                        <Grid Margin="20,0">
                            <TextBlock Text="Capability boundary" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="What the build does and does not do" Style="{StaticResource Text.Tertiary}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="CapabilityList" Margin="20,10,20,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="264"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="11" Height="11" Stretch="Uniform"
                                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"
                                          Data="{Binding Glyph}" Stroke="{Binding Brush}" StrokeThickness="1.5"
                                          Fill="Transparent"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Capability}"
                                               Style="{StaticResource Field.Value}"
                                               FontSize="{StaticResource T.Body}" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                               Style="{StaticResource Field.Value}"
                                               FontSize="{StaticResource T.Caption}"
                                               Foreground="{StaticResource B.TextSecondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource RuleV}" VerticalAlignment="Stretch"/>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Section.Bar}">
                        <TextBlock Text="Experience" Style="{StaticResource Text.Section}" Margin="20,0"/>
                    </Border>
                    <StackPanel x:Name="TogglePanel" Margin="20,14,20,20"/>

                    <Border Style="{StaticResource Section.Bar}">
                        <TextBlock Text="Rendering" Style="{StaticResource Text.Section}" Margin="20,0"/>
                    </Border>
                    <ItemsControl x:Name="RenderList" Margin="20,14,20,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               Style="{StaticResource Field.Label}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               Style="{StaticResource Field.Value}"
                                               FontSize="{StaticResource T.Caption}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Section.Bar}">
                        <TextBlock Text="Session" Style="{StaticResource Text.Section}" Margin="20,0"/>
                    </Border>
                    <ItemsControl x:Name="SessionList" Margin="20,14,20,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               Style="{StaticResource Field.Label}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               Style="{StaticResource Field.Value}"
                                               FontSize="{StaticResource T.Caption}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="20,0,20,26" Style="{StaticResource Text.Prose}"
                               FontSize="{StaticResource T.Caption}"
                               Text="Local changes made during a session — triage decisions, recorded approvals, runbook runs — live in memory only and are discarded when the application closes. Nothing is written to disk except captures you request."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
