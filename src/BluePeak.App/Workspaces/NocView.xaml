<UserControl x:Class="BluePeak.App.Workspaces.NocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BluePeak.App.Controls"
             Background="{StaticResource B.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Workspace.CommandBar}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Network Operations" Style="{StaticResource Text.Title}"/>

                <StackPanel Grid.Column="1" x:Name="FilterGroup" Orientation="Horizontal" Margin="20,0,0,0"
                            VerticalAlignment="Center"/>

                <TextBox Grid.Column="3" x:Name="SearchBox" Width="220" Tag="Filter services"
                         TextChanged="Search_Changed" Margin="0,0,12,0" VerticalAlignment="Center"/>

                <Button Grid.Column="4" x:Name="SimulateButton" Content="Open in simulator"
                        Style="{StaticResource Button.Ghost}" Click="Simulate_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="360" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Service table -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Column.Header}">
                    <Grid Margin="14,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="17"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Service" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="2" Text="Error rate" Style="{StaticResource ColumnHeader}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="Signals" Style="{StaticResource ColumnHeader}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" x:Name="ServiceList" Style="{StaticResource List}"
                         SelectionChanged="Service_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40" Margin="14,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <ctl:StatePip Grid.Column="0" State="{Binding Health}" Width="8" Height="8"
                                              HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Primary}"
                                               FontSize="{StaticResource T.Caption}"/>
                                    <TextBlock Text="{Binding LayerLabel}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                                <ctl:Sparkline Grid.Column="2" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Accent="{Binding Health}" Series="{Binding Metrics[errors]}"/>
                                <TextBlock Grid.Column="3" Text="{Binding OpenSignals}" Style="{StaticResource Text.Mono}"
                                           FontSize="{StaticResource T.Caption}" HorizontalAlignment="Right"
                                           Foreground="{Binding Health, Converter={StaticResource HealthBrush}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Background="{StaticResource B.Canvas}" BorderBrush="{StaticResource B.Hairline}"
                        BorderThickness="0,1,0,0" Padding="14,8">
                    <TextBlock x:Name="ListSummary" Style="{StaticResource Text.Tertiary}"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Dependency reasoning canvas -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Section.Bar}">
                    <Grid Margin="16,0">
                        <TextBlock Text="Dependency path" Style="{StaticResource Text.Section}"/>
                        <TextBlock x:Name="CanvasHint" Style="{StaticResource Text.Tertiary}"
                                   HorizontalAlignment="Right"
                                   Text="Click any node to move the subject"/>
                    </Grid>
                </Border>

                <ctl:DependencyCanvas Grid.Row="1" x:Name="Canvas"/>

                <Border Grid.Row="2" Background="{StaticResource B.Canvas}" BorderBrush="{StaticResource B.Hairline}"
                        BorderThickness="0,1,0,0" Padding="16,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" x:Name="VerdictBar" Width="2" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock x:Name="VerdictHeadline" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock x:Name="VerdictBody" Style="{StaticResource Text.Prose}" Margin="0,4,0,0"
                                       FontSize="{StaticResource T.Caption}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Inspector -->
            <Border Grid.Column="4" Style="{StaticResource Inspector}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource B.Overlay}" BorderBrush="{StaticResource B.Hairline}"
                            BorderThickness="0,0,0,1" Padding="16,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <ctl:StatePip x:Name="DetailPip" Width="9" Height="9" Margin="0,0,8,0"/>
                                <TextBlock x:Name="DetailState" Style="{StaticResource Text.Subtitle}"/>
                                <TextBlock x:Name="DetailSince" Style="{StaticResource Text.Tertiary}" Margin="9,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="DetailName" Style="{StaticResource Text.Title}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailReason" Style="{StaticResource Text.Prose}" Margin="0,6,0,0"
                                       FontSize="{StaticResource T.Caption}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,10,16">
                        <StackPanel>
                            <TextBlock Text="Indicators" Style="{StaticResource Text.Section}" Margin="0,0,0,9"/>
                            <ItemsControl x:Name="MetricList" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
                                            <ctl:Sparkline Grid.Column="1" Height="22" VerticalAlignment="Center"
                                                           Margin="0,0,10,0" Accent="{Binding Tone}"
                                                           Series="{Binding Series}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Reading}"
                                                       Style="{StaticResource Text.Mono}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" FontSize="{StaticResource T.Caption}"
                                                       Foreground="{Binding Tone, Converter={StaticResource HealthBrush}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Blast radius" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="BlastSummary" Style="{StaticResource Text.Prose}"
                                       FontSize="{StaticResource T.Caption}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="BlastList" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ctl:StatePip Grid.Column="0" State="{Binding Health}" Width="7" Height="7"
                                                          HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Style="{StaticResource Cell.Secondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LayerLabel}"
                                                       Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Open work on this service" Style="{StaticResource Text.Section}"
                                       Margin="0,0,0,8"/>
                            <ItemsControl x:Name="WorkList" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Link}" Click="Work_Click" Tag="{Binding}"
                                                HorizontalContentAlignment="Left" Margin="0,0,0,6" Height="Auto">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id}" Style="{StaticResource Text.Mono}"
                                                           FontSize="{StaticResource T.Caption}"
                                                           Foreground="{StaticResource B.Accent}" Margin="0,0,9,0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource T.Caption}"
                                                           Foreground="{StaticResource B.TextSecondary}"
                                                           MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Verification" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="VerificationText" Style="{StaticResource Text.Prose}"
                                       FontSize="{StaticResource T.Caption}" Margin="0,0,0,10"/>
                            <Button x:Name="DiagnoseButton" Content="Run dependency walk"
                                    Style="{StaticResource Button.Standard}" HorizontalAlignment="Left"
                                    Click="Diagnose_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
