<UserControl x:Class="BluePeak.App.Workspaces.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BluePeak.App.Controls"
             Background="{StaticResource B.Base}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Command bar ===================== -->
        <Border Grid.Row="0" Style="{StaticResource Workspace.CommandBar}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Operations Board" Style="{StaticResource Text.Title}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" Fill="{StaticResource B.Hairline}" Margin="0,0,14,0"/>
                    <ctl:StatePip x:Name="VerdictPip" Width="8" Height="8" Margin="0,0,7,0"/>
                    <TextBlock x:Name="VerdictText" Style="{StaticResource Text.Subtitle}"/>
                    <TextBlock x:Name="VerdictDetail" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0"
                               FontSize="{StaticResource T.Caption}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="AsOfText" Style="{StaticResource Text.Tertiary}" Margin="0,0,14,0"/>
                    <Button Content="Open simulator" Style="{StaticResource Button.Ghost}" Click="OpenSimulator_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Body ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="430" MinWidth="330"/>
            </Grid.ColumnDefinitions>

            <!-- = Left: what to do, then what changed = -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="250"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Section.Bar}">
                    <Grid Margin="18,0">
                        <TextBlock Text="Needs attention" Style="{StaticResource Text.Section}"/>
                        <TextBlock x:Name="AttentionCount" Style="{StaticResource Text.Tertiary}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ListBox x:Name="AttentionList" Grid.Row="1" Style="{StaticResource List}"
                         SelectionChanged="Attention_SelectionChanged"
                         MouseDoubleClick="Attention_Open" KeyDown="Attention_Key">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="58" Margin="16,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>

                                <!-- rank -->
                                <TextBlock Grid.Column="0" Text="{Binding Rank}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource F.Mono}" FontSize="{StaticResource T.Caption}"
                                           Foreground="{StaticResource B.TextTertiary}"/>

                                <!-- classification + id -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left"
                                            Background="{Binding Tone, Converter={StaticResource Wash}, ConverterParameter=0.14}"
                                            BorderBrush="{Binding Tone, Converter={StaticResource Wash}, ConverterParameter=0.4}">
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Chip.Text}"
                                                   Foreground="{Binding Tone, Converter={StaticResource HealthBrush}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource Cell.Id}" Margin="1,4,0,0"/>
                                </StackPanel>

                                <!-- title, reason, next action -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Cell.Primary}"
                                               FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Cell.Secondary}"
                                               Margin="0,2,0,0" MaxHeight="15"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Path Data="{StaticResource I.Chevron}" Stroke="{StaticResource B.Accent}"
                                              StrokeThickness="1.3" Width="8" Height="8" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding NextAction}" FontSize="{StaticResource T.Caption}"
                                                   Foreground="{StaticResource B.Accent}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- magnitude -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,18,0"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Metric}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource F.Mono}" FontSize="15"
                                               Foreground="{Binding Tone, Converter={StaticResource HealthBrush}}"/>
                                    <TextBlock Text="{Binding MetricLabel}" HorizontalAlignment="Right"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- ownership and age -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Age}" Style="{StaticResource Text.Mono}"
                                               FontSize="{StaticResource T.Caption}"
                                               Foreground="{StaticResource B.TextSecondary}"/>
                                    <TextBlock Text="{Binding Owner}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Style="{StaticResource Rule}"/>

                <Border Grid.Row="3" Style="{StaticResource Section.Bar}">
                    <Grid Margin="18,0">
                        <TextBlock Text="What changed" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="Last 90 minutes · newest first" Style="{StaticResource Text.Tertiary}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Activity as a real time axis, not a list of bubbles -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="0,6,0,10">
                    <ItemsControl x:Name="ActivityList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="152"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding At, Converter={StaticResource Clock}}"
                                               Margin="18,0,0,0" Style="{StaticResource Text.Mono}"
                                               FontSize="{StaticResource T.Caption}"
                                               Foreground="{StaticResource B.TextTertiary}"/>
                                    <Grid Grid.Column="1">
                                        <Rectangle Width="1" Fill="{StaticResource B.Hairline}" HorizontalAlignment="Center"/>
                                        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{Binding Weight, Converter={StaticResource SeverityBrush}}"/>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding Actor}" Margin="10,0,10,0"
                                               Style="{StaticResource Cell.Secondary}" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" Margin="0,0,18,0"
                                               Style="{StaticResource Cell.Primary}"
                                               FontSize="{StaticResource T.Caption}"
                                               Foreground="{StaticResource B.TextSecondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- = Right: state of the estate = -->
            <Grid Grid.Column="2" Background="{StaticResource B.Canvas}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Section.Bar}" Background="{StaticResource B.Base}">
                    <TextBlock Text="Health by layer" Style="{StaticResource Text.Section}" Margin="16,0"/>
                </Border>

                <ItemsControl Grid.Row="1" x:Name="LayerList" Margin="0,2,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Layer_Click"
                                    Tag="{Binding Layer}" ToolTip="{Binding Detail}">
                                <Grid Height="30" Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="*" MinWidth="70"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <ctl:StatePip Grid.Column="0" State="{Binding Worst}" Width="8" Height="8"
                                                  Margin="0,0,9,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Cell.Primary}"
                                               FontSize="{StaticResource T.Caption}"/>
                                    <Grid Grid.Column="2" Margin="0,0,12,0">
                                        <ctl:DistributionBar Height="4" VerticalAlignment="Center"
                                                             Critical="{Binding Rollup.Critical}"
                                                             Degraded="{Binding Rollup.Degraded}"
                                                             Healthy="{Binding Rollup.Healthy}"
                                                             Maintenance="{Binding Rollup.Maintenance}"/>
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{Binding Verdict}" Style="{StaticResource Text.Tertiary}"
                                               HorizontalAlignment="Right" Margin="0,0,10,0"
                                               Foreground="{Binding Worst, Converter={StaticResource HealthBrush}}"
                                               Opacity="0.9"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Rollup.Total}" Style="{StaticResource Text.Mono}"
                                               FontSize="{StaticResource T.Caption}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource B.TextTertiary}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2" Style="{StaticResource Section.Bar}" Background="{StaticResource B.Base}">
                    <Grid Margin="16,0">
                        <TextBlock Text="Not healthy now" Style="{StaticResource Text.Section}"/>
                        <TextBlock x:Name="DegradedCount" Style="{StaticResource Text.Tertiary}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="3" x:Name="DegradedList" Style="{StaticResource List}"
                         SelectionChanged="Degraded_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="42" Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="110"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <ctl:StatePip Grid.Column="0" State="{Binding Health}" Width="8" Height="8"
                                              Margin="0,0,9,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Primary}"
                                               FontSize="{StaticResource T.Caption}"/>
                                    <TextBlock Text="{Binding StateReason}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ctl:Sparkline Grid.Column="2" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Accent="{Binding Health}"
                                               Series="{Binding Metrics[errors]}"
                                               ToolTip="Error rate over the last four hours"/>
                                <TextBlock Grid.Column="3" Text="{Binding DegradedSince, Converter={StaticResource Ago}}"
                                           Style="{StaticResource Text.Mono}" FontSize="{StaticResource T.Caption}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource B.TextSecondary}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="4" Style="{StaticResource Section.Bar}" Background="{StaticResource B.Base}">
                    <Grid Margin="16,0">
                        <TextBlock Text="At risk — not failing yet" Style="{StaticResource Text.Section}"/>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="5" x:Name="RiskList" Margin="0,4,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,0,16,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="{Binding Tone, Converter={StaticResource HealthBrush}}"
                                           Width="2" HorizontalAlignment="Left" Opacity="0.75"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Grid>
                                        <TextBlock Text="{Binding Subject}" Style="{StaticResource Cell.Primary}"
                                                   FontSize="{StaticResource T.Caption}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Horizon}" HorizontalAlignment="Right"
                                                   Style="{StaticResource Text.Mono}" FontSize="{StaticResource T.Micro}"
                                                   Foreground="{Binding Tone, Converter={StaticResource HealthBrush}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Statement}" Style="{StaticResource Text.Prose}"
                                               FontSize="{StaticResource T.Caption}" LineHeight="16" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
