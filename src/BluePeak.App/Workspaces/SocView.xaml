<UserControl x:Class="BluePeak.App.Workspaces.SocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BluePeak.App.Controls"
             Background="{StaticResource B.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Workspace.CommandBar}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Security Operations" Style="{StaticResource Text.Title}"/>
                <StackPanel Grid.Column="1" x:Name="FilterGroup" Orientation="Horizontal" Margin="20,0,0,0"
                            VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="QueueSummary" Style="{StaticResource Text.Tertiary}" Margin="0,0,14,0"/>
                    <Button Content="Open in simulator" Style="{StaticResource Button.Ghost}" Click="Simulate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="368" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Signal queue -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Column.Header}">
                    <Grid Margin="14,0,12,0">
                        <TextBlock Text="Signal queue" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="Age" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" x:Name="AlertList" Style="{StaticResource List}"
                         SelectionChanged="Alert_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="62" Margin="14,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Left"
                                           Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource Cell.Id}"
                                                   FontSize="{StaticResource T.Caption}"/>
                                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0"
                                                Background="{Binding Severity, Converter={StaticResource Wash}, ConverterParameter=0.14}"
                                                BorderBrush="{Binding Severity, Converter={StaticResource Wash}, ConverterParameter=0.38}">
                                            <TextBlock Text="{Binding Severity}" Style="{StaticResource Chip.Text}"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                        </Border>
                                        <TextBlock Text="{Binding CaseId}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Mono}" FontSize="{StaticResource T.Micro}"
                                                   Foreground="{StaticResource B.Accent}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Rule}" Style="{StaticResource Cell.Primary}"
                                               FontSize="{StaticResource T.Caption}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Technique}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FirstSeen, Converter={StaticResource Ago}}"
                                               Style="{StaticResource Text.Mono}" FontSize="{StaticResource T.Caption}"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource B.TextSecondary}"/>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Tertiary}"
                                               HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Investigation -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource B.Canvas}" BorderBrush="{StaticResource B.Hairline}"
                        BorderThickness="0,0,0,1" Padding="18,13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock x:Name="CaseId" Style="{StaticResource Text.Mono}"
                                       Foreground="{StaticResource B.TextSecondary}"/>
                            <Border x:Name="CaseSeverityChip" Style="{StaticResource Chip}" Margin="10,0,0,0">
                                <TextBlock x:Name="CaseSeverityText" Style="{StaticResource Chip.Text}"/>
                            </Border>
                            <TextBlock x:Name="CaseOwner" Style="{StaticResource Text.Tertiary}" Margin="10,0,0,0"/>
                            <TextBlock x:Name="CaseAge" Style="{StaticResource Text.Tertiary}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="CaseTitle" Style="{StaticResource Text.Title}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CaseHypothesis" Style="{StaticResource Text.Prose}" Margin="0,7,0,0"
                                   FontSize="{StaticResource T.Caption}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Section.Bar}">
                    <Grid Margin="18,0">
                        <TextBlock Text="Correlated entities" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="Click an entity to inspect it" Style="{StaticResource Text.Tertiary}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ctl:EntityGraph Grid.Row="2" x:Name="Graph"/>

                <Border Grid.Row="3" Style="{StaticResource Section.Bar}">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Investigation timeline"
                                   Style="{StaticResource Text.Section}"/>
                        <TextBlock Grid.Column="1" x:Name="VerdictLabel" Style="{StaticResource Text.Tertiary}"
                                   HorizontalAlignment="Right" Margin="14,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="0,6,0,10">
                    <ItemsControl x:Name="TimelineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding At, Converter={StaticResource Clock}}"
                                               Margin="18,0,0,0" Style="{StaticResource Text.Mono}"
                                               FontSize="{StaticResource T.Caption}"
                                               Foreground="{StaticResource B.TextTertiary}"/>
                                    <Grid Grid.Column="1">
                                        <Rectangle Width="1" Fill="{StaticResource B.Hairline}" HorizontalAlignment="Center"/>
                                        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{Binding Weight, Converter={StaticResource SeverityBrush}}"/>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding Actor}" Margin="10,0,10,0"
                                               Style="{StaticResource Cell.Secondary}" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" Margin="0,0,18,0"
                                               Style="{StaticResource Cell.Primary}" FontSize="{StaticResource T.Caption}"
                                               Foreground="{StaticResource B.TextSecondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Entity and response -->
            <Border Grid.Column="4" Style="{StaticResource Inspector}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource B.Overlay}" BorderBrush="{StaticResource B.Hairline}"
                            BorderThickness="0,0,0,1" Padding="16,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock x:Name="EntityKindText" Style="{StaticResource Text.Mono}"
                                           FontSize="{StaticResource T.Micro}"
                                           Foreground="{StaticResource B.TextTertiary}"/>
                                <TextBlock x:Name="EntityRisk" Margin="10,0,0,0" Style="{StaticResource Text.Mono}"
                                           FontSize="{StaticResource T.Caption}"/>
                                <TextBlock x:Name="EntityManaged" Margin="10,0,0,0" Style="{StaticResource Text.Tertiary}"/>
                            </StackPanel>
                            <TextBlock x:Name="EntityName" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="EntityContext" Style="{StaticResource Text.Prose}" Margin="0,6,0,0"
                                       FontSize="{StaticResource T.Caption}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,10,18">
                        <StackPanel>
                            <TextBlock Text="Attributes" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="AttributeList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                       Style="{StaticResource Field.Label}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       Style="{StaticResource Field.Value}"
                                                       FontSize="{StaticResource T.Caption}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Response plan" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="TaskList" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="1"
                                                    VerticalAlignment="Top" Margin="0,4,10,0"
                                                    Background="{Binding State, Converter={StaticResource GateBrush}}"/>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Primary}"
                                                               FontSize="{StaticResource T.Caption}"/>
                                                    <TextBlock Text="{Binding Phase}" Style="{StaticResource Text.Tertiary}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Prose}"
                                                           FontSize="{StaticResource T.Caption}" Margin="0,2,0,0"
                                                           Visibility="{Binding Detail, Converter={StaticResource NullVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Act" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="ActionPanel"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
