<UserControl x:Class="BluePeak.App.Workspaces.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BluePeak.App.Controls"
             Background="{StaticResource B.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Workspace.CommandBar}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Diagnostics" Style="{StaticResource Text.Title}"/>
                <StackPanel Grid.Column="1" x:Name="PathGroup" Orientation="Horizontal" Margin="20,0,0,0"
                            VerticalAlignment="Center"/>
                <Button Grid.Column="3" Content="Open in simulator" Style="{StaticResource Button.Ghost}"
                        Click="Simulate_Click"/>
            </Grid>
        </Border>

        <!-- The request under test, stated exactly. -->
        <Border Grid.Row="1" Style="{StaticResource Workspace.SubBar}" Height="Auto">
            <Grid Margin="18,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="REQUEST" Style="{StaticResource Text.Section}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="1" x:Name="RequestText" Style="{StaticResource Text.Mono}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" x:Name="RunMeta" Style="{StaticResource Text.Tertiary}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="392" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,10,0,20">
                <ItemsControl x:Name="HopList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RowBackground}" Padding="0,0,0,0" Margin="0,0,0,2">
                                <Grid Margin="18,10,20,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Left"
                                               Fill="{Binding Result, Converter={StaticResource HealthBrush}}"
                                               Visibility="{Binding ShowBand, Converter={StaticResource BoolVis}}"/>

                                    <TextBlock Grid.Column="1" Text="{Binding IndexLabel}" VerticalAlignment="Top"
                                               Margin="10,1,0,0" Style="{StaticResource Text.Mono}"
                                               FontSize="{StaticResource T.Caption}"
                                               Foreground="{StaticResource B.TextTertiary}"/>

                                    <!-- Rail: continuous line with a node per hop -->
                                    <Grid Grid.Column="2">
                                        <Rectangle Width="1" Fill="{StaticResource B.Hairline}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                   Margin="0,-12,0,-14"/>
                                        <ctl:StatePip State="{Binding Result}" Width="9" Height="9"
                                                      HorizontalAlignment="Center" VerticalAlignment="Top"
                                                      Margin="0,3,0,0"/>
                                    </Grid>

                                    <StackPanel Grid.Column="3" Margin="12,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Subtitle}"/>
                                                <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                        Background="#FF1A2230" BorderBrush="#FF2A3644"
                                                        Visibility="{Binding IsFirstFailure, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="FIRST FAILURE" Style="{StaticResource Chip.Text}"
                                                               Foreground="{StaticResource B.Critical}"/>
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                        Background="#FF1A1F27" BorderBrush="#FF262E38"
                                                        Visibility="{Binding IsConsequence, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="CONSEQUENCE" Style="{StaticResource Chip.Text}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ServiceName}"
                                                       Style="{StaticResource Text.Tertiary}" Margin="0,0,14,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Elapsed}"
                                                       Style="{StaticResource Text.Mono}"
                                                       FontSize="{StaticResource T.Caption}"
                                                       Foreground="{Binding Result, Converter={StaticResource HealthBrush}}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Operation}" Style="{StaticResource Text.Secondary}"
                                                   FontSize="{StaticResource T.Caption}" Margin="0,3,0,0"/>

                                        <!-- Expected against actual, aligned so divergence is obvious -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Expected"
                                                       Style="{StaticResource Field.Label}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Expected}"
                                                       Style="{StaticResource Field.Value}"
                                                       FontSize="{StaticResource T.Caption}"
                                                       Foreground="{StaticResource B.TextSecondary}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Actual"
                                                       Style="{StaticResource Field.Label}" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Actual}"
                                                       Style="{StaticResource Field.Value}" Margin="0,4,0,0"
                                                       FontSize="{StaticResource T.Caption}"
                                                       Foreground="{Binding ActualBrush}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Reasoning}" Style="{StaticResource Text.Prose}"
                                                   FontSize="{StaticResource T.Caption}" Margin="0,8,0,0"
                                                   Foreground="{StaticResource B.TextTertiary}"/>

                                        <Button Content="{Binding EvidenceCaption}" Style="{StaticResource Link}"
                                                Margin="0,6,0,0" Click="Evidence_Click" Tag="{Binding EvidenceId}"
                                                Visibility="{Binding EvidenceId, Converter={StaticResource NullVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Border Grid.Column="2" Style="{StaticResource Inspector}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,10,18">
                    <StackPanel>
                        <TextBlock Text="Conclusion" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <Border x:Name="ConclusionBorder" BorderThickness="2,0,0,0" Padding="12,2,0,2"
                                Margin="0,0,0,16">
                            <TextBlock x:Name="ConclusionText" Style="{StaticResource Text.Prose}"
                                       Foreground="{StaticResource B.TextPrimary}"/>
                        </Border>

                        <TextBlock Text="First failure" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ctl:StatePip Grid.Column="0" x:Name="FirstFailurePip" Width="9" Height="9"
                                          Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="FirstFailureName" Style="{StaticResource Text.Subtitle}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="FirstFailureReason" Style="{StaticResource Text.Prose}"
                                           FontSize="{StaticResource T.Caption}" Margin="0,4,0,0"/>
                                <Button x:Name="OpenServiceButton" Content="Open in NOC" Style="{StaticResource Link}"
                                        Margin="0,7,0,0" Click="OpenService_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Downstream consequence" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="BlastList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ctl:StatePip Grid.Column="0" State="{Binding Health}" Width="7" Height="7"
                                                      HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Style="{StaticResource Cell.Secondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LayerLabel}"
                                                   Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Proof" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="EvidenceList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Link}" Click="Evidence_Click" Tag="{Binding Id}"
                                            Height="Auto" Margin="0,0,0,8" HorizontalContentAlignment="Left">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id}" Style="{StaticResource Text.Mono}"
                                                           FontSize="{StaticResource T.Caption}"
                                                           Foreground="{StaticResource B.Accent}"/>
                                                <TextBlock Text="{Binding Result}" Margin="9,0,0,0"
                                                           FontSize="{StaticResource T.Micro}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Result, Converter={StaticResource ResultBrush}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Claim}" Style="{StaticResource Text.Prose}"
                                                       FontSize="{StaticResource T.Caption}" Margin="0,3,0,0"
                                                       MaxWidth="330"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Next" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <StackPanel x:Name="ActionPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
