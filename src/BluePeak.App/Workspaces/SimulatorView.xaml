<UserControl x:Class="BluePeak.App.Workspaces.SimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BluePeak.App.Controls"
             Background="#FF06080B">

    <UserControl.Resources>
        <!-- The simulator deliberately breaks the product's surface language: panels float over
             the scene instead of dividing it, and every label is technical rather than editorial. -->
        <Style x:Key="Sim.Panel" TargetType="Border">
            <Setter Property="Background" Value="#E60A0E13"/>
            <Setter Property="BorderBrush" Value="#FF1C2632"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="Sim.Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="#FF5C6879"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <Style x:Key="Sim.Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.UI}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="Sim.Button" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Background" Value="#FF121822"/>
            <Setter Property="BorderBrush" Value="#FF243040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
        </Style>

        <Style x:Key="Sim.Transport" TargetType="Button" BasedOn="{StaticResource Sim.Button}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">

        <!-- Background is full bleed; the 3D stage is inset to whatever the panels leave free,
             so the machine is always centred in the space the operator can actually see. -->
        <Grid>
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.82" RadiusY="0.86">
                    <GradientStop Color="#FF11161D" Offset="0"/>
                    <GradientStop Color="#FF080B10" Offset="0.62"/>
                    <GradientStop Color="#FF04060A" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>

        <Grid x:Name="ViewportHost" Margin="452,0,0,0"/>

        <!-- ======================= Running: top context bar ======================= -->
        <Border x:Name="TopBar" Style="{StaticResource Sim.Panel}" VerticalAlignment="Top"
                BorderThickness="0,0,0,1" Background="#CC080B10" Height="46" Visibility="Collapsed">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BackButton" Style="{StaticResource Sim.Button}"
                        Click="Back_Click" Margin="0,0,14,0" ToolTip="Return to the journey list">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource I.Back}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"/>
                        <TextBlock Text="Journeys" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Chip}" Background="#334C9DF0" BorderBrush="#554C9DF0">
                            <TextBlock x:Name="DisciplineChip" Style="{StaticResource Chip.Text}"
                                       Foreground="{StaticResource B.Accent}"/>
                        </Border>
                        <TextBlock x:Name="JourneyName" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource F.Display}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="JourneyQuestion" Margin="20,0,20,0" VerticalAlignment="Center"
                           FontSize="{StaticResource T.Caption}" Foreground="{StaticResource B.TextTertiary}"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Scenario" Style="{StaticResource Sim.Label}" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="ScenarioPicker" Width="210" SelectionChanged="Scenario_Changed"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <TextBlock Grid.Column="4" x:Name="FrameStat" VerticalAlignment="Center"
                           FontFamily="{StaticResource F.Mono}" FontSize="10"
                           Foreground="#FF41505F"/>
            </Grid>
        </Border>

        <!-- ======================= Running: inspector ======================= -->
        <Border x:Name="Inspector" Style="{StaticResource Sim.Panel}" Width="392"
                HorizontalAlignment="Right" Margin="0,46,0,116" Visibility="Collapsed"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Stage header -->
                <Border Grid.Row="0" Background="#FF0D131A" BorderBrush="#FF1C2632" BorderThickness="0,0,0,1"
                        Padding="16,12,16,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Border x:Name="StageKindChip" Style="{StaticResource Chip}">
                                <TextBlock x:Name="StageKindText" Style="{StaticResource Chip.Text}"/>
                            </Border>
                            <TextBlock x:Name="StageIndexText" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource F.Mono}" FontSize="10"
                                       Foreground="#FF4E5B6C"/>
                            <Border x:Name="VerdictChip" Style="{StaticResource Chip}" Margin="10,0,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="VerdictText" Style="{StaticResource Chip.Text}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="StageTitle" FontFamily="{StaticResource F.Display}" FontSize="15"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StageCaption" Style="{StaticResource Sim.Value}"
                                   Foreground="{StaticResource B.TextSecondary}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Module under inspection -->
                <Border Grid.Row="1" x:Name="ModulePanel" Background="#FF0A0F15" BorderBrush="#FF1C2632"
                        BorderThickness="0,0,0,1" Padding="16,11,16,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Module under inspection" Style="{StaticResource Sim.Label}"
                                   Margin="0,0,0,7"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FF141C26" BorderBrush="#FF2A3746" BorderThickness="1"
                                    CornerRadius="2" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock x:Name="ModuleCode" FontFamily="{StaticResource F.Mono}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"/>
                            </Border>
                            <TextBlock x:Name="ModuleName" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="13" FontWeight="Medium"/>
                            <ctl:StatePip x:Name="ModulePip" Width="8" Height="8" Margin="10,0,0,0"/>
                            <TextBlock x:Name="ModuleState" Margin="7,0,0,0" VerticalAlignment="Center"
                                       FontSize="{StaticResource T.Caption}"/>
                        </StackPanel>
                        <TextBlock x:Name="ModuleRole" Style="{StaticResource Sim.Value}"
                                   Foreground="{StaticResource B.TextSecondary}" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Inspection detail -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,12,10,12">
                    <StackPanel>
                        <TextBlock Text="Inspection" Style="{StaticResource Sim.Label}" Margin="0,0,0,9"/>
                        <ItemsControl x:Name="DetailList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="108"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Left"
                                                   VerticalAlignment="Stretch"
                                                   Fill="{Binding Tone, Converter={StaticResource HealthBrush}}"
                                                   Visibility="{Binding HasTone, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Sim.Label}"
                                                   Margin="10,1,10,0" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Sim.Value}"
                                                   Foreground="{Binding ValueBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Visible relationships" Style="{StaticResource Sim.Label}"
                                   Margin="0,10,0,8" x:Name="RelationshipHeader"/>
                        <ItemsControl x:Name="LinkList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="14" Height="2" VerticalAlignment="Center"
                                                   Margin="0,0,9,0"
                                                   Fill="{Binding Tone, Converter={StaticResource HealthBrush}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Route}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource F.Mono}" FontSize="10"
                                                   Foreground="#FF6C7A8B" Margin="0,0,9,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center"
                                                   FontSize="{StaticResource T.Caption}"
                                                   Foreground="{StaticResource B.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Carry the subject out of the simulator into the rest of the product -->
                <Border Grid.Row="3" Background="#FF0D131A" BorderBrush="#FF1C2632" BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="Carry this to" Style="{StaticResource Sim.Label}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="HandoffPanel" Orientation="Horizontal"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======================= Running: transport ======================= -->
        <Border x:Name="Transport" Style="{StaticResource Sim.Panel}" VerticalAlignment="Bottom"
                BorderThickness="0,1,0,0" Background="#E6070A0E" Height="116" Visibility="Collapsed">
            <Grid Margin="16,10,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="ReplayButton" Style="{StaticResource Sim.Transport}" Click="Replay_Click"
                                ToolTip="Replay from the beginning">
                            <Path Data="{StaticResource I.Replay}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" Fill="Transparent"/>
                        </Button>
                        <Button x:Name="StepBackButton" Style="{StaticResource Sim.Transport}" Click="StepBack_Click"
                                Margin="6,0,0,0" ToolTip="Previous stage">
                            <Path Data="{StaticResource I.StepBack}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource Sim.Transport}" Click="PlayPause_Click"
                                Margin="6,0,0,0" Width="44" Background="#FF16324F" BorderBrush="#FF2C5D95"
                                Foreground="{StaticResource B.TextPrimary}" ToolTip="Play or pause (Space)">
                            <Path x:Name="PlayGlyph" Data="{StaticResource I.Play}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="StepForwardButton" Style="{StaticResource Sim.Transport}" Click="StepForward_Click"
                                Margin="6,0,0,0" ToolTip="Next stage">
                            <Path Data="{StaticResource I.StepForward}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <Rectangle Width="1" Height="20" Fill="#FF1C2632" Margin="14,0"/>

                        <TextBlock Text="Rate" Style="{StaticResource Sim.Label}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <StackPanel x:Name="SpeedGroup" Orientation="Horizontal"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="PlaybackStateText" Style="{StaticResource Sim.Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <ctl:JourneyScrubBar x:Name="ScrubBar" Grid.Row="1" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- ======================= Journey chooser ======================= -->
        <Border x:Name="Chooser" Style="{StaticResource Sim.Panel}" Width="452" HorizontalAlignment="Left"
                BorderThickness="0,0,1,0" Background="#F00A0D12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,26,24,18">
                    <TextBlock Text="OPERATIONS CORE SIMULATOR" FontFamily="{StaticResource F.Mono}"
                               FontSize="10" Foreground="{StaticResource B.Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="The estate as one machine" FontFamily="{StaticResource F.Display}"
                               FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,9,0,0" Style="{StaticResource Sim.Value}"
                               Foreground="{StaticResource B.TextSecondary}"
                               Text="Every subsystem in the estate is a module docked to a common spine. Choose a journey and the machine opens along the dependency path it exercises: parts disengage, interfaces become visible, and the point where expected and actual diverge is exposed in place."/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="JourneyList" Style="{StaticResource List}" Background="Transparent"
                             SelectionChanged="Journey_Selected" MouseDoubleClick="Journey_Launch"
                             KeyDown="Journey_Key" Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="24,0,20,0" Height="86">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,14,0,0">
                                        <Border Style="{StaticResource Chip}"
                                                Background="{Binding Weight, Converter={StaticResource Wash}, ConverterParameter=0.14}"
                                                BorderBrush="{Binding Weight, Converter={StaticResource Wash}, ConverterParameter=0.4}">
                                            <TextBlock Text="{Binding Discipline}" Style="{StaticResource Chip.Text}"
                                                       Foreground="{Binding Weight, Converter={StaticResource SeverityBrush}}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontSize="13.5" FontWeight="Medium"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Question}" Margin="0,6,0,0"
                                               FontSize="{StaticResource T.Caption}"
                                               Foreground="{StaticResource B.TextSecondary}" TextWrapping="Wrap"
                                               MaxHeight="32"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="{Binding StageSummary}" FontFamily="{StaticResource F.Mono}"
                                                   FontSize="10" Foreground="#FF4E5B6C"/>
                                        <TextBlock Text="{Binding LinkSummary}" FontFamily="{StaticResource F.Mono}"
                                                   FontSize="10" Foreground="#FF3E6E9E" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="#FF1C2632" BorderThickness="0,1,0,0" Padding="24,14,24,18">
                    <StackPanel>
                        <TextBlock x:Name="ChooserSummary" Style="{StaticResource Sim.Value}"
                                   Foreground="{StaticResource B.TextSecondary}" Margin="0,0,0,12"
                                   MaxHeight="72" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="LaunchButton" Content="Run journey" Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Left" Height="30" Padding="20,0" Click="Journey_Launch"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
