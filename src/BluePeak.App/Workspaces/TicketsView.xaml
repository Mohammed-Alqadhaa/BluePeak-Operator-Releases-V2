<UserControl x:Class="BluePeak.App.Workspaces.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BluePeak.App.Controls"
             Background="{StaticResource B.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Workspace.CommandBar}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tickets" Style="{StaticResource Text.Title}"/>
                <StackPanel Grid.Column="1" x:Name="FilterGroup" Orientation="Horizontal" Margin="20,0,0,0"
                            VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" x:Name="SearchBox" Width="220" Tag="Filter tickets"
                         TextChanged="Search_Changed" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" x:Name="Summary" Style="{StaticResource Text.Tertiary}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Column.Header}">
                    <Grid Margin="18,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="106"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ticket" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="1" Text="Priority" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="2" Text="Subject" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="3" Text="Requester" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="4" Text="Assignee" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Grid.Column="5" Text="SLA" Style="{StaticResource ColumnHeader}"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" x:Name="TicketList" Style="{StaticResource List}"
                         SelectionChanged="Ticket_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="46" Margin="18,0,18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="106"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Ticket.Id}" Style="{StaticResource Cell.Id}"/>
                                    <TextBlock Text="{Binding Ticket.State, Converter={StaticResource EnumLabel}}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource Chip}" HorizontalAlignment="Left"
                                        Background="{Binding Ticket.Priority, Converter={StaticResource Wash}, ConverterParameter=0.14}"
                                        BorderBrush="{Binding Ticket.Priority, Converter={StaticResource Wash}, ConverterParameter=0.38}">
                                    <TextBlock Text="{Binding Ticket.Priority}" Style="{StaticResource Chip.Text}"
                                               Foreground="{Binding Ticket.Priority, Converter={StaticResource SeverityBrush}}"/>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Ticket.Subject}" Style="{StaticResource Cell.Primary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding ContextLabel}" Style="{StaticResource Text.Tertiary}"
                                                   Foreground="{Binding ContextBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Ticket.Requester}" Style="{StaticResource Cell.Secondary}"/>
                                    <TextBlock Text="{Binding Ticket.Department}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Ticket.Assignee}" Style="{StaticResource Cell.Secondary}"
                                               Foreground="{Binding AssigneeBrush}"/>
                                    <TextBlock Text="{Binding Ticket.Queue}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SlaLabel}" Style="{StaticResource Text.Mono}"
                                               FontSize="{StaticResource T.Caption}"
                                               Foreground="{Binding SlaTone, Converter={StaticResource HealthBrush}}"/>
                                    <ctl:MeterBar Height="3" Margin="0,5,10,0" Value="{Binding SlaFraction}"
                                                  State="{Binding SlaTone}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Border Grid.Column="2" Style="{StaticResource Inspector}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource B.Overlay}" BorderBrush="{StaticResource B.Hairline}"
                            BorderThickness="0,0,0,1" Padding="16,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <TextBlock x:Name="DetailId" Style="{StaticResource Text.Mono}"
                                           Foreground="{StaticResource B.TextSecondary}"/>
                                <Border x:Name="DetailPriorityChip" Style="{StaticResource Chip}" Margin="10,0,0,0">
                                    <TextBlock x:Name="DetailPriorityText" Style="{StaticResource Chip.Text}"/>
                                </Border>
                                <TextBlock x:Name="DetailChannel" Margin="10,0,0,0" Style="{StaticResource Text.Tertiary}"/>
                            </StackPanel>
                            <TextBlock x:Name="DetailSubject" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailSummary" Style="{StaticResource Text.Prose}" Margin="0,7,0,0"
                                       FontSize="{StaticResource T.Caption}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,10,18">
                        <StackPanel>
                            <TextBlock Text="Service level" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SlaHeadline" Style="{StaticResource Text.Subtitle}"/>
                                    <TextBlock x:Name="SlaDetail" Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ctl:MeterBar Grid.Column="1" x:Name="SlaMeter" Width="110" Height="5"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="Context" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ContextList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Style="{StaticResource Field.Label}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       Style="{StaticResource Field.Value}"
                                                       FontSize="{StaticResource T.Caption}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Contact history" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="TimelineList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Rectangle Width="1" Fill="#FF232B35" HorizontalAlignment="Center"
                                                           Margin="0,-9,0,-9"/>
                                                <Ellipse Width="6" Height="6" HorizontalAlignment="Center"
                                                         VerticalAlignment="Top" Margin="0,4,0,0"
                                                         Fill="{Binding Weight, Converter={StaticResource SeverityBrush}}"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding Actor}"
                                                               Style="{StaticResource Cell.Secondary}"
                                                               FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding At, Converter={StaticResource Clock}}"
                                                               Style="{StaticResource Text.Tertiary}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Prose}"
                                                           FontSize="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Next" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="ActionPanel"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
