<UserControl x:Class="BluePeak.App.Workspaces.InfrastructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BluePeak.App.Controls"
             Background="{StaticResource B.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Workspace.CommandBar}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Infrastructure" Style="{StaticResource Text.Title}"/>
                <TextBlock Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Text.Tertiary}"
                           Text="Select an element to light what it needs and what breaks without it"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Summary" Style="{StaticResource Text.Tertiary}" Margin="0,0,14,0"/>
                    <Button Content="Clear selection" Style="{StaticResource Button.Ghost}" Click="Clear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="376" MinWidth="310"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ctl:LayerMap x:Name="Map"/>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Border Grid.Column="2" Style="{StaticResource Inspector}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource B.Overlay}" BorderBrush="{StaticResource B.Hairline}"
                            BorderThickness="0,0,0,1" Padding="16,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <ctl:StatePip x:Name="DetailPip" Width="9" Height="9" Margin="0,0,8,0"/>
                                <TextBlock x:Name="DetailState" Style="{StaticResource Text.Subtitle}"/>
                                <TextBlock x:Name="DetailLayer" Style="{StaticResource Text.Tertiary}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="DetailName" Style="{StaticResource Text.Title}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailReason" Style="{StaticResource Text.Prose}" Margin="0,6,0,0"
                                       FontSize="{StaticResource T.Caption}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,10,18">
                        <StackPanel>
                            <!-- The four questions this workspace exists to answer -->
                            <ItemsControl x:Name="AnswerList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Left"
                                                       Fill="{Binding Tone, Converter={StaticResource HealthBrush}}"/>
                                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                <TextBlock Text="{Binding Question}"
                                                           Style="{StaticResource Text.Tertiary}"/>
                                                <TextBlock Text="{Binding Answer}" Style="{StaticResource Field.Value}"
                                                           Margin="0,3,0,0" FontSize="{StaticResource T.Caption}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Requires" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="RequiresList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ctl:StatePip Grid.Column="0" State="{Binding Node.Health}" Width="7"
                                                          Height="7" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Node.Name}"
                                                       Style="{StaticResource Cell.Secondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Protocol}"
                                                       Style="{StaticResource Text.Mono}"
                                                       FontSize="{StaticResource T.Micro}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource B.TextTertiary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Breaks if this fails" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="BreaksList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ctl:StatePip Grid.Column="0" State="{Binding Health}" Width="7" Height="7"
                                                          HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Style="{StaticResource Cell.Secondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LayerLabel}"
                                                       Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Attributes" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="AttributeList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Style="{StaticResource Field.Label}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       Style="{StaticResource Field.Value}"
                                                       FontSize="{StaticResource T.Caption}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="ActionPanel"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
