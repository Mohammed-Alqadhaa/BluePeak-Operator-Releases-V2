<UserControl x:Class="BluePeak.App.Workspaces.ChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BluePeak.App.Controls"
             Background="{StaticResource B.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Workspace.CommandBar}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Change Control" Style="{StaticResource Text.Title}"/>
                <StackPanel Grid.Column="1" x:Name="FilterGroup" Orientation="Horizontal" Margin="20,0,0,0"
                            VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" x:Name="Summary" Style="{StaticResource Text.Tertiary}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="270"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="356" MinWidth="290"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Column.Header}">
                    <Grid Margin="14,0,12,0">
                        <TextBlock Text="Change" Style="{StaticResource ColumnHeader}"/>
                        <TextBlock Text="Window" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" x:Name="ChangeList" Style="{StaticResource List}"
                         SelectionChanged="Change_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="62" Margin="14,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Left"
                                           Fill="{Binding RiskTone, Converter={StaticResource HealthBrush}}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Change.Id}" Style="{StaticResource Cell.Id}"
                                                   FontSize="{StaticResource T.Caption}"/>
                                        <TextBlock Text="{Binding Change.Type}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Style="{StaticResource Text.Tertiary}"/>
                                        <TextBlock Text="{Binding Change.State, Converter={StaticResource EnumLabel}}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Tertiary}"
                                                   Foreground="{Binding StateBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Change.Title}" Style="{StaticResource Cell.Primary}"
                                               FontSize="{StaticResource T.Caption}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" MaxHeight="30"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding WindowLabel}" VerticalAlignment="Center"
                                           Style="{StaticResource Text.Mono}" FontSize="{StaticResource T.Caption}"
                                           Foreground="{StaticResource B.TextSecondary}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource B.Canvas}" BorderBrush="{StaticResource B.Hairline}"
                            BorderThickness="0,0,0,1" Padding="20,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <TextBlock x:Name="DetailId" Style="{StaticResource Text.Mono}"
                                           Foreground="{StaticResource B.TextSecondary}"/>
                                <Border x:Name="RiskChip" Style="{StaticResource Chip}" Margin="10,0,0,0">
                                    <TextBlock x:Name="RiskText" Style="{StaticResource Chip.Text}"/>
                                </Border>
                                <TextBlock x:Name="DetailType" Margin="10,0,0,0" Style="{StaticResource Text.Tertiary}"/>
                                <TextBlock x:Name="DetailWindow" Margin="10,0,0,0" Style="{StaticResource Text.Tertiary}"/>
                            </StackPanel>
                            <TextBlock x:Name="DetailTitle" Style="{StaticResource Text.Display}" FontSize="18"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailDescription" Style="{StaticResource Text.Prose}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section.Bar}">
                        <Grid Margin="20,0">
                            <TextBlock Text="Consequence if this goes wrong" Style="{StaticResource Text.Section}"/>
                            <TextBlock x:Name="BlastSummary" Style="{StaticResource Text.Tertiary}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="BlastList" Margin="0,4,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Service_Click"
                                        Tag="{Binding Node.Id}">
                                    <Grid Height="32" Margin="20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ctl:StatePip Grid.Column="0" State="{Binding Node.Health}" Width="8" Height="8"
                                                      HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Node.Name}"
                                                   Style="{StaticResource Cell.Primary}"
                                                   FontSize="{StaticResource T.Caption}" Margin="0,0,12,0"/>
                                        <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="0,0,12,0"
                                                Background="Transparent">
                                            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Chip.Text}"
                                                       Foreground="{Binding RoleBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding Node.LayerLabel}"
                                                   Style="{StaticResource Cell.Secondary}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Section.Bar}">
                        <TextBlock Text="Approval chain" Style="{StaticResource Text.Section}" Margin="20,0"/>
                    </Border>

                    <ItemsControl x:Name="ApprovalList" Margin="0,8,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="20,0,20,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="9" Height="9" CornerRadius="4.5"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"
                                            Background="{Binding State, Converter={StaticResource GateBrush}}"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Board}" Style="{StaticResource Cell.Primary}"
                                                   FontSize="{StaticResource T.Caption}"/>
                                        <TextBlock Text="{Binding Approver}" Style="{StaticResource Text.Tertiary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Comment}"
                                               Style="{StaticResource Text.Prose}"
                                               FontSize="{StaticResource T.Caption}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding State, Converter={StaticResource EnumLabel}}"
                                               VerticalAlignment="Top" Style="{StaticResource Text.Mono}"
                                               FontSize="{StaticResource T.Micro}"
                                               Foreground="{Binding State, Converter={StaticResource GateBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Section.Bar}">
                        <Grid Margin="20,0">
                            <TextBlock Text="Verification plan" Style="{StaticResource Text.Section}"/>
                            <TextBlock x:Name="VerificationSummary" Style="{StaticResource Text.Tertiary}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="VerificationList" Margin="0,8,0,18">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="20,0,20,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="9" Height="9" CornerRadius="1"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"
                                            Background="{Binding Result, Converter={StaticResource ResultBrush}}"/>
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Primary}"
                                                       FontSize="{StaticResource T.Caption}"/>
                                            <TextBlock Text="{Binding Result}" HorizontalAlignment="Right"
                                                       Style="{StaticResource Text.Mono}"
                                                       FontSize="{StaticResource T.Micro}"
                                                       Foreground="{Binding Result, Converter={StaticResource ResultBrush}}"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Method"
                                                       Style="{StaticResource Field.Label}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Method}"
                                                       Style="{StaticResource Field.Value}"
                                                       FontSize="{StaticResource T.Caption}"
                                                       Foreground="{StaticResource B.TextSecondary}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Expected"
                                                       Style="{StaticResource Field.Label}" Margin="0,3,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Expected}"
                                                       Style="{StaticResource Field.Value}" Margin="0,3,0,0"
                                                       FontSize="{StaticResource T.Caption}"
                                                       Foreground="{StaticResource B.TextSecondary}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Actual"
                                                       Style="{StaticResource Field.Label}" Margin="0,3,0,0"
                                                       Visibility="{Binding Actual, Converter={StaticResource NullVis}}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Actual}"
                                                       Style="{StaticResource Field.Value}" Margin="0,3,0,0"
                                                       FontSize="{StaticResource T.Caption}"
                                                       Foreground="{Binding Result, Converter={StaticResource ResultBrush}}"
                                                       Visibility="{Binding Actual, Converter={StaticResource NullVis}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Border Grid.Column="4" Style="{StaticResource Inspector}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,10,18">
                    <StackPanel>
                        <TextBlock Text="Decision brief" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="BriefList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Left"
                                                   Fill="{Binding Tone, Converter={StaticResource HealthBrush}}"/>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                            <TextBlock Text="{Binding Question}" Style="{StaticResource Text.Tertiary}"/>
                                            <TextBlock Text="{Binding Answer}" Style="{StaticResource Field.Value}"
                                                       Margin="0,3,0,0" FontSize="{StaticResource T.Caption}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Rollback" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="RollbackText" Style="{StaticResource Text.Prose}"
                                   FontSize="{StaticResource T.Caption}" Margin="0,0,0,16"/>

                        <TextBlock Text="Evidence" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="EvidenceEmpty" Style="{StaticResource Text.Prose}"
                                   FontSize="{StaticResource T.Caption}" Margin="0,0,0,16"
                                   Visibility="Collapsed"/>
                        <ItemsControl x:Name="EvidenceList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Link}" Click="Evidence_Click" Tag="{Binding Id}"
                                            Height="Auto" Margin="0,0,0,8" HorizontalContentAlignment="Left">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id}" Style="{StaticResource Text.Mono}"
                                                           FontSize="{StaticResource T.Caption}"
                                                           Foreground="{StaticResource B.Accent}"/>
                                                <TextBlock Text="{Binding Result}" Margin="9,0,0,0"
                                                           FontSize="{StaticResource T.Micro}" VerticalAlignment="Center"
                                                           Foreground="{Binding Result, Converter={StaticResource ResultBrush}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Claim}" Style="{StaticResource Text.Prose}"
                                                       FontSize="{StaticResource T.Caption}" Margin="0,3,0,0"
                                                       MaxWidth="300"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Next" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
                        <StackPanel x:Name="ActionPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
