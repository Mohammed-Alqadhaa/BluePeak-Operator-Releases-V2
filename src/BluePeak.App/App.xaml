<Application x:Class="BluePeak.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:BluePeak.App.Design"
             StartupUri="Shell/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/Tokens.xaml"/>
                <ResourceDictionary Source="Design/Icons.xaml"/>
                <ResourceDictionary Source="Design/Typography.xaml"/>
                <ResourceDictionary Source="Design/Controls.xaml"/>
                <ResourceDictionary Source="Design/Workspace.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <d:HealthBrushConverter x:Key="HealthBrush"/>
            <d:SeverityBrushConverter x:Key="SeverityBrush"/>
            <d:BoolToVisibilityConverter x:Key="BoolVis"/>
            <d:NullToVisibilityConverter x:Key="NullVis"/>
            <d:CountToVisibilityConverter x:Key="CountVis"/>
            <d:AgoConverter x:Key="Ago"/>
            <d:ClockConverter x:Key="Clock"/>
            <d:EnumLabelConverter x:Key="EnumLabel"/>
            <d:OpacityConverter x:Key="Op"/>
            <d:FractionWidthConverter x:Key="FractionWidth"/>
            <d:GateBrushConverter x:Key="GateBrush"/>
            <d:EvidenceResultBrushConverter x:Key="ResultBrush"/>
            <d:AuthorityBrushConverter x:Key="AuthorityBrush"/>
            <d:WashBrushConverter x:Key="Wash"/>
            <d:IconLookupConverter x:Key="IconLookup"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
